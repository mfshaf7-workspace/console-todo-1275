{
  "schema_version": 1,
  "owner_repo": "console-todo-1275",
  "profile_id": "little-list-owner-checks",
  "commands": [
    {
      "id": "check-1",
      "kind": "tests",
      "name": "Actual task transitions, bounds and persistence codec",
      "executable": "node",
      "args": [
        "--test",
        "app/tests/tasks.test.mjs"
      ],
      "fidelity": "pure-unit",
      "conformance_binding": "none",
      "timeout_seconds": 120
    },
    {
      "id": "check-2",
      "kind": "validations",
      "name": "Exact base/head source whitespace validation",
      "executable": "git",
      "args": [
        "diff",
        "--check",
        "{{base_commit}}",
        "{{head_commit}}"
      ],
      "fidelity": "real-git",
      "conformance_binding": "none",
      "timeout_seconds": 120
    },
    {
      "id": "browser-dependencies",
      "kind": "runtime_and_live",
      "name": "Install exact locked browser-verifier dependencies",
      "executable": "npm",
      "args": ["ci", "--ignore-scripts", "--no-audit"],
      "fidelity": "filesystem",
      "conformance_binding": "none",
      "timeout_seconds": 180
    },
    {
      "id": "browser-runtime",
      "kind": "runtime_and_live",
      "name": "Install the pinned verifier's Chromium headless shell",
      "executable": "node",
      "args": ["node_modules/playwright/cli.js", "install", "chromium", "--only-shell"],
      "fidelity": "sandbox-runtime",
      "conformance_binding": "none",
      "timeout_seconds": 180
    },
    {
      "id": "little-list-browser",
      "kind": "runtime_and_live",
      "name": "Seven serial real-browser app and explicit storage-failure checks",
      "executable": "node",
      "args": ["tests/browser/little-list.mjs"],
      "fidelity": "sandbox-runtime",
      "conformance_binding": "none",
      "timeout_seconds": 120
    }
  ]
}
